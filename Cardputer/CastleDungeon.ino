// ----------------------------------------------------------------------------
bool playAgain()
{
  char k;
  M5Cardputer.Display.setTextSize(3);
  M5Cardputer.Display.fillScreen(BLACK);
  M5.Display.setTextColor(YELLOW, BLACK);
  M5Cardputer.Display.drawString("Play again?", 21, 48);
  M5Cardputer.Display.drawString("(Y/N)", 67, 96);
  
  while(1) {
    k = getKey();
    if( k ) M5Cardputer.Speaker.tone(700, 200);
    if( k=='y' || k=='Y' ) return true;
    if( k=='n' || k=='N' ) return false;
  }
  return false; 
}

// ----------------------------------------------------------------------------
void waitKey( int sec )
{
  char k = 0;

  for( int i=0; i<sec*10; i++ ) {
    k = getKey();
    if( k ) return;
    delay(100);
  }
}

// ----------------------------------------------------------------------------
char getKey()
{
  char k = 0;
  M5Cardputer.update(); 
  if (M5Cardputer.Keyboard.isChange()) {
    if (M5Cardputer.Keyboard.isPressed()) {
      Keyboard_Class::KeysState status = M5Cardputer.Keyboard.keysState();
        if (status.word.size() > 0) {
          k = status.word[0]; // Grab the character
        }        
    }
  }
  return k;
}

// ----------------------------------------------------------------------------
void sfxStep( void )
{
  M5Cardputer.Speaker.tone(500, 200);
  delay(100);
}

// ----------------------------------------------------------------------------
void sfxBumped( void )
{
  M5Cardputer.Speaker.tone(700, 200);
  delay(100);
}

// ----------------------------------------------------------------------------
void sfxOpenDoor( void )
{
  int f, n;
  for( n=0; n<5; n++) {
    f = 1000+n*100;
