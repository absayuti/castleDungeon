void pitFall( int r, int c )
{
  showSprite( ' ', X+XOFF, Y, 0 );
  showSprite( '$', XOFF+X*(1+c), Y*(1+r), 1 );
  sfxPitfall();
  M5Cardputer.Display.setTextSize(3);
  M5.Display.setTextColor(ORANGE, BLACK);
  M5Cardputer.Display.drawString("YOU FELL", 0, 32);
  M5Cardputer.Display.drawString("INTO A PIT!", 0, 62);
  delay(3000);
}

// ----------------------------------------------------------------------------
// Levitating
void levitate( int r, int c)
{
  M5Cardputer.Speaker.tone(1000, 100);
  showSprite( ' ', X+XOFF, Y, 0 );
  if( facing ) showSprite( 'R', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 1 );
  else showSprite( 'L', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 1 );
  delay(200);
  M5Cardputer.Speaker.tone(2000, 100);
  delay(200);
}

// ----------------------------------------------------------------------------
void doorBumped(int r)
{
  showSprite( ' ', X+XOFF, Y, 0 );
  showSprite( '$', X+XOFF, Y*(1+0.5*r), 1 );
  //man.pushRotateZoom(X+XOFF, Y*(1+0.5*r), 0, 2.8, 2.8, TRACOL);
  sfxBumped();
  showSprite( ' ', X+XOFF, Y*(1+0.5*r), 0 );
  showSprite( '$', X+XOFF, Y, 0 );
}

