// ----------------------------------------------------------------------------
void setupSprite(M5Canvas &s, const uint8_t *data) 
{
  s.createSprite(16, 16);
  s.setColorDepth(8);
  s.pushImage(0, 0, 16, 16, data);
  s.setPivot(0, 0);
}

// ================================= M A I N ====================================
void loop() 
{
  int  r = 0, c = 0;
  char ch;
  unsigned long currMillis;
  
  while( playgame ) {
    setupMaze();
    resetGameVars();

    while( !gameover ) {

      readKeyboard( &r, &c );
      ch = maze[row+r][col+c];
      switch( ch ) {
        case ' ': 
                  if( c || r ) sfxStep();
                  break;
        case '#': 
                  r = 0;
                  c = 0;
                  sfxBumped();
                  break;
        case '!': 
                  removeItem( row+r, col+c );
                  usword = true;
                  sword.pushRotateZoom(2, 2, 0, 2, 2, TRACOL);
                  break;
        case '+': 
                  removeItem( row+r, col+c );
                  ukey = true;
                  key.pushRotateZoom(34, 2, 0, 2, 2, TRACOL);
                  break;
        case '*': 
                  removeItem( row+r, col+c );
                  ubombs++;
                  if( ubombs>0 ) bomb.pushRotateZoom(2, 34, 0, 2, 2, TRACOL);
                  if( ubombs>1 ) bomb.pushRotateZoom(36, 34, 0, 2, 2, TRACOL);
                  if( ubombs>2 ) bomb.pushRotateZoom(70, 34, 0, 2, 2, TRACOL);
                  break;
        case '@':
                  if( uspell==0 ) {
                    pitFall( r, c );
                    gameover = true;
                  }
                  else if( uspell==1 ) levitate( r, c );
                  break;
        case '&':
                  if( usword ) 
                    killBeast( r, c );
                  else {
                    beastLost( r, c );
                    gameover = true;
                  }
                  break;
        case '-':
                  if( ukey ) { 
                    sfxOpenDoor();
                    maze[row+r][col+c] = ' ';
                  }
                  else {
                    doorBumped( r );
                    r = 0;
                    c = 0;
                  }
      } // switch-case
      // Cancel spell after 1 step
      if( r || c ) {
        if( uspell==2 ) {
          uspell = 0;
          M5Cardputer.Display.fillRect(2*34+2, 2, 30, 30, DARKGREY);
        }
        if( uspell==1 ) uspell = 2;
      }
      row = row + r;
      col = col + c;
  
      // Update/check timer
      currMillis = millis();
      if( currMillis - prevMillis >= INTERVAL ) {
        prevMillis = currMillis;
        secondsLeft--;
        M5Cardputer.Display.setCursor(0, 72);
        M5Cardputer.Display.printf("%d ", secondsLeft);
        if( secondsLeft <= 0 ) {
          timesUp();
          gameover = true;
        }
      }
      // Refresh display
      updateDisplay( ch );
      // Check number of bombs collected
      if( ubombs==3 ) { 
          castleSaved();
          gameover = true;
      }
      delay(100);
    } // while !gameover
    
    playgame = playAgain();
    
  } // while playgame
 
  M5Cardputer.Display.fillScreen(BLACK);
}

// ----------------------------------------------------------------------------
void setupMaze()
{
  for( int r=0; r<ROW; r++ ) {
    for( int c=0; c<COL; c++ ) {
      maze[r][c] = emptyMaze[r][c];
    }
  }
  
  // Place items at random places in maze
  placeItemRoom('*', 3);  // Bombs
  placeItemRoom('&',12);  // Beasts
  placeItem('@', 3);      // Pits
  placeItem('+', 1);      // Key
  placeItem('!', 1);      // Sword

  // Setup info box on left
  M5Cardputer.Display.fillRect(0, 0, 104, 135, BLACK);
  for( int r=0; r<2; r++ )
    for( int c=0; c<3; c++ )
      M5Cardputer.Display.fillRect(c*34+2, r*34+2, 30, 30, DARKGREY);

  // Set default text size & colours
  M5.Display.setTextColor(YELLOW, BLACK);
  M5Cardputer.Display.setTextSize(2);
}

// ----------------------------------------------------------------------------
void resetGameVars()
{
  // Set initial player's position in maze
  do {
    row = esp_random()%ROW;
    col = esp_random()%ROW;
  } while( maze[row][col] != ' ');

  // For debugging...
  //row = 18; col = 2; 
  //maze[18][4] = '@'; 
  //maze[18][5] = '!'; 
  //maze[18][7] = '*'; 
  //maze[18][8] = '*'; 
  
  // Reset game variables
  playgame = true;
  gameover = false;
  uspell = 0;
  ukey = false;
  usword = false;
  ubombs = 0;
  prevMillis = millis();
  secondsLeft = SECONDS;
}

// ----------------------------------------------------------------------------
void placeItem( char c, int n )
{
  int row, col, i;

  for( i=0; i<n; i++ ) {
    do {
      row = esp_random()%ROW;
      col = esp_random()%ROW;
    } while( maze[row][col] != ' ');
    maze[row][col] = c;
  }
}

// ----------------------------------------------------------------------------
void placeItemRoom( char c, int n )
{
  int row, col, i;

  for( i=0; i<n; i++ ) {
    do {
      row = esp_random()%ROW;
      col = esp_random()%ROW;
    } while( maze[row][col] != '.');
    maze[row][col] = c;
  }
}

// ----------------------------------------------------------------------------
void readKeyboard( int *r, int *c )
{
  char k;
  *r = 0; *c = 0;
  k = getKey();

  if( k != 63 ) {
    M5Cardputer.Display.fillRect(0, 88, 104, 48, BLACK);
    switch( k ) {
      case 59:  *r = -1;
                arrowup.pushRotateZoom(34, 88, 0, 2, 2, TRACOL);
                break;
      case 46:  *r = 1;
                arrowdown.pushRotateZoom(34, 104, 0, 2, 2, TRACOL);
                break;
      case 44:  *c = -1;
                arrowleft.pushRotateZoom(2, 96, 0, 2, 2, TRACOL);
                facing = 0;
                break;
      case 47:  *c = 1;
                arrowright.pushRotateZoom(34*2, 96, 0, 2, 2, TRACOL);
                facing = 1;
                break;
      case 108: uspell = 1;
                sfxWootwoot();
                spell.pushRotateZoom(2*34+2, 0, 0, 2, 2, TRACOL);
                break;
    }
  }
}

// ----------------------------------------------------------------------------
void updateDisplay( char ch ) 
{
  // Top row  
  ch = maze[row-1][col-1];
  showSprite( ch, XOFF, 0, 0 );
  ch = maze[row-1][col];
  showSprite( ch, X+XOFF, 0, 0 );
  ch = maze[row-1][col+1];
  showSprite( ch, X*2+XOFF, 0, 0 );
  // Middle row
  ch = maze[row][col-1];
  showSprite( ch, XOFF, Y, 0 );
  // Middle-centre cell
  ch = maze[row][col];
  int tr = 0;
  if( uspell ) {
    showSprite( ch, X+XOFF, Y, 0 );
    tr = 1;
  }
  // Show player's sprite in the middle-centre
  if( facing ) ch = 'R';
  else ch = 'L';
  showSprite( ch, X+XOFF, Y, tr);
  ch = maze[row][col+1];
  showSprite( ch, X*2+XOFF, Y, 0 );
  // Bottom row
  ch = maze[row+1][col-1];
  showSprite( ch, XOFF, Y*2, 0 );
  ch = maze[row+1][col];
  showSprite( ch, X+XOFF, Y*2, 0 );
  ch = maze[row+1][col+1];
  showSprite( ch, X*2+XOFF, Y*2, 0 ); 

  // Show timer
  //M5Cardputer.Display.setCursor(0, Y*2);
  //M5Cardputer.Display.printf("%d", secondsLeft);
  //M5.Display.setTextColor(ORANGE, BLACK);
  //M5Cardputer.Display.drawString("YOU LOST", 0, 32);
 }

// ----------------------------------------------------------------------------
void showSprite( char ch, int x, int y, int transparent ) 
{
  switch( ch ) {
    case '#': if( transparent ) wall.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else wall.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case ' ':
    case '.': if( transparent ) fl00r.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else fl00r.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '&': if( transparent ) beast.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else beast.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '*': if( transparent ) bomb.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else bomb.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '@': if( transparent ) pit.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else pit.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '-': if( transparent ) door.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else door.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '+': if( transparent ) key.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else key.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '!': if( transparent ) sword.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else sword.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case '$': if( transparent ) manleft.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else manleft.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case 'L': if( transparent ) manleft.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else manleft.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
    case 'R': if( transparent ) manright.pushRotateZoom(x, y, 0, 2.8, 2.8, TRACOL);
              else manright.pushRotateZoom(x, y, 0, 2.8, 2.8);
              break;
  }
}

// ----------------------------------------------------------------------------
void removeItem( int rr, int cc )
{
  maze[rr][cc] = ' ';
  M5Cardputer.Speaker.tone(1000, 100);
  delay(100);
  M5Cardputer.Speaker.tone(1500, 200);  
  delay(100);
}

// ----------------------------------------------------------------------------
void killBeast( int r, int c )
{
  maze[row+r][col+c] = ' ';
  showSprite( ' ', X+XOFF, Y, 0 );
  showSprite( '$', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 1 );
  //man.pushRotateZoom( XOFF+X*(1+0.5*c), Y*(1+0.5*r), 0, 2.8, 2.8, TRACOL);
  sfxBeast();
  showSprite('$', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 0 );
  //delay(500);
}

// ----------------------------------------------------------------------------
void timesUp()
{
  int n;
  for( int n=20; n>0; n-- ) {
    M5Cardputer.Speaker.tone(500+n*50, 100);
    delay(100);
  }
  M5.Display.setTextColor(RED, BLACK);
  M5Cardputer.Display.setTextSize(3);
  M5Cardputer.Display.drawString("TIME'S UP!", 0, 32);
  M5Cardputer.Display.setTextSize(2);
  M5Cardputer.Display.drawString("CASTLE DESTROYED", 0, 62);
  delay(3000);
}

// ----------------------------------------------------------------------------
void beastLost( int r, int c )
{
  showSprite( ' ', X+XOFF, Y, 0 );
  showSprite( '$', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 1 );
  //man.pushRotateZoom( XOFF+X*(1+0.5*c), Y*(1+0.5*r), 0, 2.8, 2.8, TRACOL);
  sfxBeast();
  showSprite( ' ', XOFF+X*(1+0.5*c), Y*(1+0.5*r), 0 );
  showSprite( '&', XOFF+X+X*c, Y+Y*r, 0);
  delay(1000);
  M5Cardputer.Display.setTextSize(3);
  M5.Display.setTextColor(ORANGE, BLACK);
  M5Cardputer.Display.drawString("YOU LOST", 0, 32);
  M5Cardputer.Display.drawString("TO A BEAST!", 0, 62);
  delay(3000);
}

