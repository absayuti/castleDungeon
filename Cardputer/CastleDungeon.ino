void castleSaved()
{
  M5Cardputer.Display.setTextSize(3);
  delay(1000);
  M5.Display.setTextColor(GREEN, BLACK);
  M5Cardputer.Display.drawString("YOU SAVED", 21, 48);
  M5Cardputer.Display.drawString("THE CASTLE", 18, 72);
  for( int i=0; i<2; i++)
    sfxHappy();
